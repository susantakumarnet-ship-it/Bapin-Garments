# ---------------------------------------------------------------
# BAPIN GARMENTS - server configuration
# Copy to .env and fill in. NEVER commit .env to git.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (production). Leave empty in development to use
# the embedded PostgreSQL (PGlite) stored in ./data/pglite - no install needed.
DATABASE_URL=
# Set to true for managed Postgres that requires SSL (Neon, Supabase, RDS...)
DATABASE_SSL=false

# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=8h

# Public URL of the website (used in password reset links)
PUBLIC_SITE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Image storage: set CLOUDINARY_URL to use Cloudinary, otherwise images are saved to ./uploads
CLOUDINARY_URL=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# WhatsApp Business Cloud API (Meta). Values here override the admin settings page.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# SMTP for password reset emails (if empty, reset links are printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bapin Garments <no-reply@bapingarments.com>

# Initial admin account created on first start (change password after login!)
SEED_ADMIN_NAME=Store Owner
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@bapingarments.com
SEED_ADMIN_PASSWORD=Admin@123
